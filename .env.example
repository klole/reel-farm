# Generated local values belong in .env and are never committed.
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://oss:oss@db:5432/oss
MEDIA_ROOT=/data/media
BOOTSTRAP_TOKEN=replace-with-a-local-random-token
BETTER_AUTH_SECRET=replace-with-a-local-random-secret-at-least-32-bytes
RENDERER_BUILD_ID=oss-renderer-0.1.0
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
# Host-only verification fallback. Container rendering uses the pinned browser image.
# BROWSER_EXECUTABLE_PATH=
