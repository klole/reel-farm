  const path = require("node:path");
  const base = process.env.CI_BOOTSTRAP_REPORT;
  if (typeof base !== "string" || base.length === 0 || /[\0\r\n]/.test(base)) {
    throw new Error("CI_BOOTSTRAP_REPORT must be a non-empty single-line path.");
  }
  process.stdout.write(path.resolve(path.dirname(base), "actionlint-bootstrap.json"));
')"
set +e
actionlint_bin="$(node scripts/ci/actionlint-bootstrap.mjs --report "$stage_report" --print-bin 2>"$stage_log")"
stage_exit=$?
if [[ "$stage_exit" -eq 0 ]]; then
  if [[ "$actionlint_bin" != /* || ! -x "$actionlint_bin" ]]; then
    printf 'Provisioner did not return an absolute executable path: %s\n' "$actionlint_bin" >> "$stage_log"
    stage_exit=1
  else
    export ACTIONLINT_BIN="$actionlint_bin"
    if ! grep -Fqx "ACTIONLINT_BIN=$actionlint_bin" "$GITHUB_ENV"; then
      printf 'Provisioner did not publish its verified path to GITHUB_ENV.\n' >> "$stage_log"
      stage_exit=1
    fi
