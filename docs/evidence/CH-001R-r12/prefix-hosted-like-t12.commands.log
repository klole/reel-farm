git merge-base --is-ancestor "$REQUESTED_SHA" origin/main
test -z "$(git status --porcelain --untracked-files=no)"
workflow_blob_sha="$(git rev-parse "$CH001_WORKFLOW_SHA:.github/workflows/ch001-live-proof.yml")"
workflow_file_sha256="$(sha256sum .github/workflows/ch001-live-proof.yml | awk '{print $1}')"

mkdir -p "$(dirname "$CI_BOOTSTRAP_REPORT")"
export CH001_IMPLEMENTATION_COMMIT="$actual_sha"
export CH001_WORKFLOW_BLOB_SHA="$workflow_blob_sha"
export CH001_WORKFLOW_FILE_SHA256="$workflow_file_sha256"
node scripts/ci/ci-result.mjs init --report "$CI_BOOTSTRAP_REPORT"
printf 'Bounded CH-001R-r4 live proof; not v0.1 acceptance.\nImplementation: %s\nWorkflow definition: %s\nWorkflow blob: %s\nRun: %s\n' "$REQUESTED_SHA" "$CH001_WORKFLOW_SHA" "$workflow_blob_sha" "$CH001_RUN_ID" > "$(dirname "$CI_BOOTSTRAP_REPORT")/dispatch.txt"

{
  printf 'CH001_IMPLEMENTATION_COMMIT=%s\n' "$actual_sha"
  printf 'CH001_WORKFLOW_BLOB_SHA=%s\n' "$workflow_blob_sha"
  printf 'CH001_WORKFLOW_FILE_SHA256=%s\n' "$workflow_file_sha256"
} >> "$GITHUB_ENV"
bash scripts/ci/initialize-sandbox-state.sh

step=actionlint_bootstrap body_sha256=4261577d40af9b9ced4040512d3bf978203ccc2491d2143a196ccc778f6a3967
set -euo pipefail
stage_log="$RUNNER_TEMP/ch001r8-actionlint-bootstrap.log"
stage_report="$(node --input-type=commonjs -e '
  const path = require("node:path");
  const base = process.env.CI_BOOTSTRAP_REPORT;
  if (typeof base !== "string" || base.length === 0 || /[\0\r\n]/.test(base)) {
    throw new Error("CI_BOOTSTRAP_REPORT must be a non-empty single-line path.");
  }
  process.stdout.write(path.resolve(path.dirname(base), "actionlint-bootstrap.json"));
')"
set +e
actionlint_bin="$(node scripts/ci/actionlint-bootstrap.mjs --report "$stage_report" --print-bin 2>"$stage_log")"
stage_exit=$?
if [[ "$stage_exit" -eq 0 ]]; then
  if [[ "$actionlint_bin" != /* || ! -x "$actionlint_bin" ]]; then
    printf 'Provisioner did not return an absolute executable path: %s\n' "$actionlint_bin" >> "$stage_log"
    stage_exit=1
  else
    export ACTIONLINT_BIN="$actionlint_bin"
    if ! grep -Fqx "ACTIONLINT_BIN=$actionlint_bin" "$GITHUB_ENV"; then
      printf 'Provisioner did not publish its verified path to GITHUB_ENV.\n' >> "$stage_log"
      stage_exit=1
    fi
  fi
fi
set -e
node scripts/ci/ci-result.mjs record-stage --report "$CI_BOOTSTRAP_REPORT" --name actionlint-bootstrap --exit-code "$stage_exit" --detail-file "$stage_report" --log-file "$stage_log"
rm -f "$stage_log"
exit "$stage_exit"

