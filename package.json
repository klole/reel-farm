{
  "name": "open-slideshow-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": { "node": ">=20.9.0 <21" },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "dev": "pnpm --parallel --filter @oss/web --filter @oss/worker dev",
    "dev:web": "pnpm --filter @oss/web dev",
    "dev:worker": "pnpm --filter @oss/worker dev",
    "build": "pnpm --filter @oss/contracts build && pnpm --filter @oss/db build && pnpm --filter @oss/storage build && pnpm --filter @oss/renderer build && pnpm --filter @oss/core build && pnpm --filter @oss/web build && pnpm --filter @oss/worker build",
    "start": "pnpm --filter @oss/web start",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.json",
    "test:unit": "vitest run --config vitest.config.ts tests/unit",
    "test:integration": "tsx scripts/run-gated-check.ts integration",
    "test:e2e": "tsx scripts/run-gated-check.ts e2e",
    "test:render": "tsx scripts/run-gated-check.ts render",
    "test:security": "vitest run --config vitest.config.ts tests/security",
    "test:smoke": "tsx scripts/run-gated-check.ts smoke",
    "verify:ch001": "tsx scripts/verify-ch001.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "archiver": "8.0.0",
    "better-auth": "1.7.4",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "pg": "8.16.3",
    "pg-boss": "12.31.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/archiver": "6.0.3",
    "@types/node": "20.19.2",
    "@types/pg": "8.16.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
